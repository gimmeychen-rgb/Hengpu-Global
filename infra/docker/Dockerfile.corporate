# Build only the corporate workspace; no business application source is copied.
ARG NODE_IMAGE=node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
ARG NGINX_IMAGE=nginx:1.30.5-alpine3.24-slim@sha256:32463212baf0e7d91aded2e9b843a4f2b9e017804b8c9d5bae7b51dcef64389c
FROM ${NODE_IMAGE} AS build
WORKDIR /build
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/package.json
# Optional trusted CA is ephemeral and never copied into a layer/runtime image.
RUN --mount=type=secret,id=corporate_build_ca \
    if [ -f /run/secrets/corporate_build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/corporate_build_ca; fi; \
    npm ci --workspace apps/web --include-workspace-root=false --ignore-scripts --no-audit --no-fund
COPY apps/web ./apps/web
ARG CORPORATE_SITE_URL=https://hengpuglobal.com
ENV CORPORATE_SITE_URL=${CORPORATE_SITE_URL}
RUN npm --workspace apps/web run build

FROM ${NGINX_IMAGE} AS runtime
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/* /docker-entrypoint.d /docker-entrypoint.sh
COPY --chmod=0644 infra/nginx/corporate.conf /etc/nginx/nginx.conf
COPY --from=build /build/apps/web/out/ /usr/share/nginx/html/
RUN find /usr/share/nginx/html -type d -exec chmod 0755 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 0644 {} +
ARG CORPORATE_REVISION=uncommitted
LABEL org.opencontainers.image.title="Hengpu corporate static website" \
      org.opencontainers.image.revision="${CORPORATE_REVISION}"
USER nginx
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
